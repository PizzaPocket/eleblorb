; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Eleblorbs"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.035, 0.055, 0.075, 1)
boot_splash/show_image=false

[autoload]

InputMapSetup="*res://scripts/input_map.gd"
MobileControls="*res://scripts/mobile_controls.gd"
CheatCodes="*res://scripts/cheat_codes.gd"
TokoinWallet="*res://scripts/tokoin_wallet.gd"
Inventory="*res://scripts/inventory.gd"
UIState="*res://scripts/ui_state.gd"
UISounds="*res://scripts/ui_sounds.gd"
InteractionManager="*res://scripts/interaction_manager.gd"
HeldItem="*res://scripts/held_item.gd"
Hud="*res://scripts/hud.gd"
DialogUI="*res://scripts/dialog_ui.gd"
BlorbTransformationUI="*res://scripts/blorb_transformation_ui.gd"
ShopUI="*res://scripts/shop_ui.gd"
InventoryUI="*res://scripts/inventory_ui.gd"
PauseMenu="*res://scripts/pause_menu.gd"
LoadingScreen="*res://scripts/loading_screen.gd"
WorldState="*res://scripts/world_state.gd"
Party="*res://scripts/party.gd"
KingdomTravel="*res://scripts/kingdom_travel.gd"

[input_devices]

pointing/emulate_mouse_from_touch=false
