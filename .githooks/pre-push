#!/bin/sh
set -eu

# Quick checks on every push.
python3 tools/check_body_pose_owner.py
python3 tools/check_power_parity.py
python3 tools/check_design_language.py

# The village validators (headless Godot) run only for what the push changes:
# a settlement's own files run its validator; shared game code runs them all;
# documents and drawings run none (tools/changed_villages.py). Set
# ELEBLORB_HOOK_ALL=1 to run every one.
VILLAGES=$(python3 tools/changed_villages.py)
if [ -z "$VILLAGES" ]; then
	echo "pre-push: no village files changed; village validators skipped."
	exit 0
fi
for village in $VILLAGES; do
	echo "pre-push: validating $village"
	VILLAGE=$village sh tools/check_village_layout.sh
done
