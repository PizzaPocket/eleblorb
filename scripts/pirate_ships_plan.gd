## The hull's half-breadth (metres from the centreline) at length z and height y.
static func hull_half_breadth(ship: String, z: float, y: float) -> float:
	var h: Dictionary = SHIPS[ship]["hull"]
	var half_len := float(h["length"]) * 0.5
	var t := z / half_len
	if t >= 1.0 or t <= -1.0:
		return 0.0
	var plan := 0.0
	if t > 0.0:
		plan = pow(1.0 - pow(t, float(h["bow_n"])), 1.0 / float(h["bow_n"]))
	else:
		plan = pow(1.0 - pow(-t, float(h["stern_n"])), 1.0 / float(h["stern_n"]))
		if -t < 0.995:
			plan = maxf(plan, float(h["transom"]))
	var section := 0.0
	if y < 0.0:
		var d := -y / float(h["draft"])
		if d >= 1.0:
			return 0.0
		section = sqrt(1.0 - pow(d, 2.5))
	else:
		section = 1.0 - float(h["tumble"]) * pow(minf(1.0, y / float(h["tumble_top"])), 2.0) - float(h.get("tumble_above", 0.0)) * maxf(0.0, y - float(h["tumble_top"])) / 3.0
	return float(h["beam"]) * 0.5 * plan * section
