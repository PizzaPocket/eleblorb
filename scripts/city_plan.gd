 "parts": ["louvre_leaf"], "parent": [1.185, 1.31, 0.03], "centre": 0.87, "eps": [5.5, 4.0], "cuts": [[1, 0, 0, 0.0]], "hinge": "outer", "rule": "two louvred leaves from one parent the size of the closed opening, cut at the floor too; they are thrown back flat on the wall either side"}, {"id": "crown_fold", "kind": "meet", "parts": ["crown_n1", "crown_n2", "crown_s1", "crown_s2", "crown_w", "crown_e", "crown_ridge"], "plane": "the mitre plane of each shared edge; the springing plane y = 150 under the facets", "rule": "the plaza and back faces are warped quadrilaterals, so each is two plates on one named diagonal (plaza NE-Wf, back SE-Wb); every plate is cut at the plane it shares with its neighbour, so the edges meet on straight lines with no gap, no overlap and no ledge; the eye lies wholly inside crown_n1"}, {"id": "col_ends", "kind": "chain", "parts": ["base_post", "corner_post", "fire_post", "gallery_post", "stair_post", "rail_bar"], "plane": "what it stands on, and what it carries", "rule": "cut flat at both ends and capped: a base post from the forecourt to the soffit, a corner post from the soffit to the springing, a rail post from its floor to under its rail"}, {"id": "rail_bays", "kind": "chain", "parts": ["fire_rail", "gallery_rail", "stair_rail"], "plane": "the faces of the posts at each end of a bay", "rule": "each bay's rail is cut at the faces of what carries it, with no gap and no overlap"}, {"id": "ramp_ends", "kind": "chain", "parts": ["fire_ramp"], "plane": "the landing's edge at each end of a flight", "rule": "a flight is cut at the planes of the two landings it joins, from the same datum (7.5 m a flight): flush at both ends, no ledge"}, {"id": "stair_run", "kind": "chain", "parts": ["stair_tread"], "plane": "each tread's front and back planes", "rule": "a step every 0.29 m along and 0.2 m up; the first tread's top is 0.2 above the arena floor, the last of flight B is flush with the gallery floor, the last of A flush with the landing"}, {"id": "glass_bays", "kind": "chain", "parts": ["gallery_glass"], "plane": "the post faces", "rule": "each pane spans post to post and is cut at both"}, {"id": "rib_ends", "kind": "chain", "parts": ["crown_rib"], "plane": "the arena floor's plane and the ridge facet's plane", "rule": "each rib runs on its facet from the springing to the ridge, cut at both and capped"}, {"id": "pipe_ends", "kind": "chain", "parts": ["plant_pipe"], "plane": "the walls' inner faces", "rule": "cut at the west and east inner faces and capped"}, {"id": "car_ends", "kind": "chain", "parts": ["car_wall"], "plane": "the car's floor top and roof underside", "rule": "cut flat at both and capped; the three walls stand on the floor and stop under the roof"}, {"id": "seated", "kind": "seated", "parts": ["plant_duct"], "plane": "the top of what it stands on", "rule": "cut flat at that plane and capped; no gap, no buried half"}, {"id": "against_wall", "kind": "seated", "parts": ["vent_hood", "louvre_sill", "fire_landing", "rail_bracket", "door_bar", "car_panel", "plant_fan"], "plane": "the wall's outer (or inner) face", "rule": "cut at the wall face and capped; it stands proud of the wall by its depth, nothing sunk into the wall"}, {"id": "on_surface", "kind": "placed", "parts": ["door_opening", "louvre_opening", "eye_slit", "lift_landing", "vent_hood", "rail_bracket"], "plane": "the face as it is", "rule": "only on a flat run of a face; the corner posts and the facets' edges carry nothing"}, {"id": "punched", "kind": "punched", "parts": ["door_opening", "door_surround", "louvre_opening", "louvre_surround", "eye_slit", "eye_surround", "lift_cavity", "lift_landing", "lift_surround"], "plane": "through the wall", "rule": "one closed cutter per opening; a doorway is its leaves' own silhouette (outline) grown by its clearance, so frame and leaf are one shape; an opening that reaches the floor (floor) is flat there; the glass is the cutter intersected with the wall, the ring the cutter grown by its ring less the 