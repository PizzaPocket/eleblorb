[node name="DirectionalLight3D" type="DirectionalLight3D" parent="." unique_id=428974637]
transform = Transform3D(0.81915206, 0.51983684, -0.24240386, 0, 0.42261824, 0.9063078, 0.57357645, -0.7424039, 0.3461886, 0, 20, 0)
light_energy = 1.0
shadow_enabled = true
# Defaults to 0 (perfectly parallel rays), which is what made the clouds'
# shadows on the ground razor-sharp regardless of how far away they are --
# a real sun has a small but nonzero angular size, which is what actually
# produces the soft, distance-dependent penumbra (contact-hardening)
# real shadows have. 1.5 is a stylized exaggeration of the real sun's
# ~0.53 degrees, chosen for a visibly soft edge rather than a physically
# exact one.
light_angular_distance = 1.5

