fog_enabled = true
fog_light_color = Color(0.78, 0.89, 0.98, 1)
fog_density = 0.0025
# 0.0, not the old 0.15 -- per a further direct correction, even that
# reduced amount still visibly muted the sky. Fog now only ever fades
# distant geometry (its actual intended job), never blends over the sky
# itself. day_night_cycle.gd sets this explicitly at runtime too (belt and
# suspenders); this static value is just what a designer opening the scene
# sees before the cycle script's first frame runs.
fog_sky_affect = 0.0

